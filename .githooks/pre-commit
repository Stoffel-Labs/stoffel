#!/usr/bin/env bash
set -euo pipefail

# MPC parties run as `stoffel run-node`, a subcommand of the CLI binary.
runner_bin="stoffel"
runner_package="stoffel-cli"
ci_workflow=".github/workflows/ci.yml"

published_package_pattern="stoffel-vm|stoffel-vm-types|stoffellang|stoffel-rust-sdk|stoffel-bindgen|stoffelcrypto|stoffelnet|stoffel-mpc-coordinator-shared|stoffel-mpc-coordinator-off-chain"
stale_package_refs="$(mktemp)"

# A `[patch.crates-io]` table is never part of a published manifest, so a git
# override there cannot leak into a release. It is still only tolerated when the
# table is explicitly marked temporary: its header must directly follow a comment
# block containing "TEMPORARY" (e.g. docs/design/bootnode-elimination.md §9.F.5, the
# unpublished stoffel-mpc-coordinator 0.3.0). Those lines are listed, not
# rejected, so the override stays visible until it is deleted.
temporary_patch_lines="$(mktemp)"
trap 'rm -f "$stale_package_refs" "$temporary_patch_lines"' EXIT
git ls-files -- '*.toml' ':!target' | while read -r manifest; do
  awk -v file="$manifest" '
    /^[[:space:]]*\[/ {
      in_temporary_patch = ($0 ~ /^[[:space:]]*\[patch\.crates-io\][[:space:]]*$/ && temporary_comment)
    }
    in_temporary_patch && !/^[[:space:]]*(\[|#|$)/ { print file ":" FNR ":" $0 }
    # Whether the comment block directly above the current line says TEMPORARY.
    /^[[:space:]]*#/ { temporary_comment = temporary_comment || /TEMPORARY/; next }
    { temporary_comment = 0 }
  ' "$manifest"
done >"$temporary_patch_lines"

git grep -n -E "(git|branch|rev|tag)[[:space:]]*=[[:space:]]*\"" -- \
  '*.toml' '*.rs' '*.sh' '*.yml' '*.yaml' \
  ':!target' \
  ':!.git' \
  ':!.githooks/pre-commit' |
  grep -E "$published_package_pattern|StoffelVM|Stoffel-Labs/stoffel" |
  grep -v -x -F -f "$temporary_patch_lines" >>"$stale_package_refs" || true

if [ -s "$temporary_patch_lines" ]; then
  echo "note: temporary [patch.crates-io] overrides still present (delete them once published):" >&2
  sed 's/^/  /' "$temporary_patch_lines" >&2
fi

git grep -n -E "(package[[:space:]]*=[[:space:]]*\"(${published_package_pattern})\"[^}]*path[[:space:]]*=|(${published_package_pattern})[[:space:]]*=[[:space:]]*\\{[^}]*path[[:space:]]*=)" -- \
  '*.toml' '*.rs' '*.sh' '*.yml' '*.yaml' \
  ':!target' \
  ':!.git' \
  ':!.githooks/pre-commit' |
  grep -v -E 'version[[:space:]]*=' |
  grep -v -E \
    '^(crates/stoffel-cli/Cargo.toml|crates/stoffel-rust-sdk/Cargo.toml|crates/stoffel-lang/examples/mpc_aes128_cbc_client_io/Cargo.toml|crates/stoffel-cli/tests/cli.rs):' \
  >>"$stale_package_refs" || true

# stoffel-vm-runner and its stoffel-run binary were removed; nothing may build them.
git grep -n -E "(-p|--package)[[:space:]]+stoffel-vm(-runner)?[[:space:]]+--bin[[:space:]]+stoffel-run" -- \
  ':!target' \
  ':!.git' \
  ':!.githooks/pre-commit' >>"$stale_package_refs" || true

if [ -s "$stale_package_refs" ]; then
  cat >&2 <<MSG

error: found stale package references.

Stoffel crates and generated SDK templates should use published crate
dependencies unless the path dependency is an explicit monorepo-development
exception in this hook.

MSG
  cat "$stale_package_refs" >&2
  exit 1
fi

if [ "${1:-}" = "--manifest-scan-only" ]; then
  echo "pre-commit: manifest scan passed"
  exit 0
fi

if [ -f "$ci_workflow" ] && ! grep -Eq "cargo build .*--package[[:space:]]+${runner_package}[[:space:]]+--bin[[:space:]]+${runner_bin}" "$ci_workflow"; then
  cat >&2 <<MSG
error: ${ci_workflow} does not build ${runner_bin} from ${runner_package}.
MSG
  exit 1
fi

echo "pre-commit: checking formatting"
cargo +nightly fmt --all -- --check

echo "pre-commit: checking package/bin mapping"
cargo +nightly check --package "$runner_package" --bin "$runner_bin"

echo "pre-commit: running clippy"
cargo +nightly clippy --workspace --all-targets -- -D warnings

echo "pre-commit: running tests"
cargo +nightly test --workspace --all-features
