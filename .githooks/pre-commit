#!/usr/bin/env bash
set -euo pipefail

# MPC parties run as `stoffel run-node`, a subcommand of the CLI binary.
runner_bin="stoffel"
runner_package="stoffel-cli"
ci_workflow=".github/workflows/ci.yml"

published_package_pattern="stoffel-vm|stoffel-vm-types|stoffellang|stoffel-rust-sdk|stoffel-bindgen|stoffelcrypto|stoffelnet|stoffel-mpc-coordinator-shared|stoffel-mpc-coordinator-off-chain"
stale_package_refs="$(mktemp)"
trap 'rm -f "$stale_package_refs"' EXIT

git grep -n -E "(git|branch|rev|tag)[[:space:]]*=[[:space:]]*\"" -- \
  '*.toml' '*.rs' '*.sh' '*.yml' '*.yaml' \
  ':!target' \
  ':!.git' \
  ':!.githooks/pre-commit' |
  # Restrict the package match to content after git grep's file:line prefix.
  # Otherwise every match below crates/stoffel-* looks like a package reference.
  grep -E ":[[:digit:]]+:.*(${published_package_pattern}|StoffelVM|Stoffel-Labs/stoffel)" \
    >>"$stale_package_refs" || true

git grep -n -E "(package[[:space:]]*=[[:space:]]*\"(${published_package_pattern})\"[^}]*path[[:space:]]*=|(${published_package_pattern})[[:space:]]*=[[:space:]]*\\{[^}]*path[[:space:]]*=)" -- \
  '*.toml' '*.rs' '*.sh' '*.yml' '*.yaml' \
  ':!target' \
  ':!.git' \
  ':!.githooks/pre-commit' |
  grep -v -E 'version[[:space:]]*=' |
  grep -v -E \
    '^(crates/stoffel-cli/Cargo.toml|crates/stoffel-rust-sdk/Cargo.toml|crates/stoffel-lang/examples/mpc_aes128_cbc_client_io/Cargo.toml|crates/stoffel-cli/tests/cli.rs):' \
  >>"$stale_package_refs" || true

# stoffel-vm-runner and its stoffel-run / stoffel-coord-ctl binaries were removed;
# nothing may build them.
git grep -n -E "(-p|--package)[[:space:]]+stoffel-vm(-runner)?[[:space:]]+--bin[[:space:]]+stoffel-(run|coord-ctl)" -- \
  ':!target' \
  ':!.git' \
  ':!.githooks/pre-commit' >>"$stale_package_refs" || true

if [ -s "$stale_package_refs" ]; then
  cat >&2 <<MSG

error: found stale package references.

Stoffel crates and generated SDK templates should use published crate
dependencies unless the path dependency is an explicit monorepo-development
exception in this hook.

MSG
  cat "$stale_package_refs" >&2
  exit 1
fi

if [ "${1:-}" = "--manifest-scan-only" ]; then
  echo "pre-commit: manifest scan passed"
  exit 0
fi

if [ -f "$ci_workflow" ] && ! grep -Eq "cargo build .*--package[[:space:]]+${runner_package}[[:space:]]+--bin[[:space:]]+${runner_bin}" "$ci_workflow"; then
  cat >&2 <<MSG
error: ${ci_workflow} does not build ${runner_bin} from ${runner_package}.
MSG
  exit 1
fi

# Match CI even when a developer has a directory override or an older nightly.
RUSTUP_TOOLCHAIN="$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)"
export RUSTUP_TOOLCHAIN
: "${RUSTUP_TOOLCHAIN:?missing channel in rust-toolchain.toml}"

echo "pre-commit: checking formatting"
cargo fmt --all -- --check

echo "pre-commit: checking package/bin mapping"
cargo check --package "$runner_package" --bin "$runner_bin"

echo "pre-commit: running clippy"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-commit: running tests"
cargo test --workspace --all-features

echo "pre-commit: running heavyweight CLI tests serially"
cargo test -p stoffel-cli --test cli -- --ignored --test-threads=1

echo "pre-commit: running local coordinator lifecycle regressions serially"
cargo test -p stoffel-cli --test run_node_local_coordinator_e2e -- --ignored --test-threads=1 --skip optimized_aes --skip batch_mul
